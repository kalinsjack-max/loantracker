rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // private phone/address: only the owner can read or write
    match /private/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /entries/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.creatorUid == resource.data.creatorUid
        && (request.resource.data.amount == resource.data.amount
            || (resource.data.creatorUid == request.auth.uid
                && resource.data.paid == 0
                && (resource.data.status != 'accepted' || resource.data.participants.size() == 1)));
      allow delete: if signedIn() && resource.data.creatorUid == request.auth.uid;
    }
    match /notifications/{id} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }
  }
}
